    {
      "parameters": {
        "promptType": "define",
        "text": "={{ \"اسم المنتج: \" + $('Webhook Trigger1').item.json.body.name + \"\\nالوصف البسيط: \" + $('Webhook Trigger1').item.json.body.description + \"\\nالسعر: \" + $('Webhook Trigger1').item.json.body.price }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a product content specialist for an online clothing store that sells jeans, sweaters, and pajamas for men, women, and kids.\n\nGiven a product name and a simple description, return ONLY a valid JSON object with these 3 fields:\n\n1. marketing_description: a professional, attractive marketing description in Arabic, 2-3 short sentences, based only on the given info. Do not invent materials, sizes, or colors that were not mentioned.\n2. category: exactly one of these values: \"جينز\" , \"كنزات\" , \"بيجامات\" , \"أخرى\"\n3. audience: exactly one of these values: \"رجال\" , \"نساء\" , \"أطفال\" , \"الكل\"\n\nReturn JSON only, no extra text, no markdown."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
