              "fieldId": "=name",
              "fieldValue": "={{ $('Webhook Trigger1').item.json.body.name }}"
            },
            {
              "fieldId": "=price",
              "fieldValue": "={{ Number($('Webhook Trigger1').item.json.body.price) }}"
            },
            {
              "fieldId": "=simple_description",
              "fieldValue": "={{ $('Webhook Trigger1').item.json.body.description }}"
            },
            {
              "fieldId": "=marketing_description",
              "fieldValue": "={{ JSON.parse($json.text.replace(/```json|```/g, '').trim()).marketing_description }}"
            },
            {
              "fieldId": "=category",
              "fieldValue": "={{ JSON.parse($json.text.replace(/```json|```/g, '').trim()).category }}"
            },
            {
              "fieldId": "=audience",
              "fieldValue": "={{ JSON.parse($json.text.replace(/```json|```/g, '').trim()).audience }}"
            },
